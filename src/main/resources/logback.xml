<configuration>
    <statusListener class="ch.qos.logback.core.status.OnErrorConsoleStatusListener"/>

    <timestamp key="startTs" datePattern="yyyy-MM-dd_HH-mm-ss_SSS"/>
    <property name="LOG_DIR" value="${avrix.log.dir:-./logs}"/>

    <appender name="ISOLATED_CONSOLE" class="com.avrix.logger.IsolatedConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${console.level:-INFO}</level>
        </filter>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [ %thread ] %-5level > %msg%n%ex</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>

        <file>${LOG_DIR}/log_${startTs}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/log_${startTs}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [ %thread ] %-5level > %msg%n%ex</pattern>
        </encoder>
    </appender>

    <root level="TRACE">
        <appender-ref ref="ISOLATED_CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>